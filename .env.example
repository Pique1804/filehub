# Create both folders first. State requires write access for this UID/GID.
FILEHUB_DATA_DIR=./data
FILEHUB_STATE_DIR=./state
FILEHUB_UID=1000
FILEHUB_GID=1000

# Copy the SHA-256 from the checksum published with the downloaded Linux archive.
FILEHUB_RELEASE_SHA256=
FILEHUB_IMAGE_TAG=1.40.20
# Enable LibreOffice file previews and libvips image processing at build time.
FILEHUB_MEDIA_TOOLS=0

# The defaults bind only to the Docker host. Set both addresses for LAN access.
FILEHUB_LISTEN_ADDRESS=127.0.0.1
FILEHUB_PORT=8080
FILEHUB_PUBLIC_URL=http://localhost:8080
